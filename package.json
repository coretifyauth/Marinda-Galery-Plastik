{
  "name": "custom-erp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:erp": "npm run dev -w erp",
    "dev:pos": "npm run dev -w pos",
    "build:erp": "npm run build -w erp",
    "build:pos": "npm run build -w pos",
    "lint:erp": "npm run lint -w erp",
    "lint:pos": "npm run lint -w pos",
    "desktop:dev:pos": "npm run desktop:dev -w pos",
    "desktop:build:pos": "npm run desktop:build -w pos",
    "test:erp": "npm run test -w erp"
  }
}
